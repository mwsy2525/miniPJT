AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
# 검색어 변환처럼 짧은 작업용 빠른 모델(비우면 BEDROCK_MODEL_ID 사용)
FAST_MODEL_ID=
EMBEDDING_MODEL_ID=
SIMILARITY_THRESHOLD=0.35
RETRIEVAL_TOP_K=4
QUIZ_SEED=
PROGRESS_DB_PATH=data/progress.db
WEB_FALLBACK_ENABLED=false
WEB_INDEX_URLS=https://platform.claude.com/llms.txt,https://code.claude.com/docs/llms.txt,https://modelcontextprotocol.io/llms.txt
WEB_ALLOWED_DOMAINS=platform.claude.com,code.claude.com,modelcontextprotocol.io
WEB_TIMEOUT_SECONDS=8

# 요청 트레이스 기록(키 불필요). 끄려면 false
TRACE_LOG_ENABLED=true
TRACE_LOG_DIR=data/traces
# LangSmith를 함께 쓰려면 아래 두 값을 채운다(선택)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
